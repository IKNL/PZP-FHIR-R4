# Dutch National Terminology Server (NTS) Configuration
# Copy this file to .env and fill in your credentials

# NTS Ontoserver URL
NTS_TX_URL=https://terminologieserver.nl/fhir

# NTS Credentials (if required by your instance)
NTS_USER=your-username-here
NTS_PASS=your-password-here

# To use NTS locally with _genonce_nts.bat:
# 1. Set environment variables in PowerShell:
#    $env:NTS_TX_URL = "https://terminologieserver.nl/fhir"
#    $env:NTS_USER = "your-username"
#    $env:NTS_PASS = "your-password"
#
# 2. Or create a setenv.bat file with:
#    SET NTS_TX_URL=https://terminologieserver.nl/fhir
#    SET NTS_USER=your-username
#    SET NTS_PASS=your-password
#
# 3. Run: call setenv.bat && _genonce_nts.bat
